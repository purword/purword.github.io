---
// 基础 样式
import "./Footer.less";
import SITE_CONFIG from "@/config";
const { Site, Title, Author, CreateTime, Navs } = SITE_CONFIG;
const year = new Date().getFullYear();
const startYear = CreateTime ? new Date(CreateTime).getFullYear() : year;
---

<footer class="vh-footer">
	<main>
		<p>© {startYear}~此刻 · 《<a href={Site}>{Title}</a>》</p>
		<!--<p>备案号：<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">在此填写 ICP 备案号</a></p>-->
		<p>
			{Navs.map((item) => (
				<a href={item.link} target={item.target ? "_blank" : "_self"} rel="noopener">{item.text}</a>
			))}
		</p>
	</main>
</footer>
